# Hostelers — Environment Configuration
# Copy this file to .env and fill in the values.

# Google OAuth
# 1. Create a Google OAuth client in Google Cloud Console:
#   - Go to https://console.cloud.google.com/
#   - Navigate to APIs & Services → Credentials
#   - Click "Create credentials" → "OAuth client ID"
#   - Select "Web application"
#   - Authorized JavaScript origins: http://localhost:5173
#   - Authorized redirect URIs: http://localhost:5173/api/auth/google/callback
# 2. Copy the Client ID and Secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Application
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Session / Security
SESSION_SECRET=a_very_secret_key_change_this_in_production
CSRF_ENABLED=true

# Database (choose one)
# If using MongoDB:
# DATABASE_URL=mongodb://localhost:27017/hostelers

# If using PostgreSQL:
# DATABASE_URL=postgresql://localhost:5432/hostelers

# JWT (for session tokens)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here